# --- required ---------------------------------------------------------------
# Bearer token the agent must present. Generate a strong one:
#   openssl rand -hex 24
BRIDGE_TOKEN=

# --- hardware ---------------------------------------------------------------
# Set to 1 to run without a robot (laptop demo / wiring up the timeline path).
# Set to 0 (or unset) on the real bridge host once the G1 is on the LAN.
G1_MOCK=1

# Network interface on the bridge host that is on the same LAN/DDS domain as
# the G1 (e.g. eth0, en0). Ignored in mock mode.
G1_NET_IFACE=eth0

# --- tuning (optional) ------------------------------------------------------
# Motion rate limit: max N motion commands per window seconds.
RATE_MAX=5
RATE_WINDOW_SEC=10
LOG_LEVEL=INFO
